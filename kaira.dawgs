
print("===== PYTHON CALCULATOR =====")

num1 = float(input("Enter first number: "))
operator = input("Choose (+, -, *, /): ")
num2 = float(input("Enter second number: "))

if operator == "+":
    result = num1 + num2
elif operator == "-":
    result = num1 - num2
elif operator == "*":
    result = num1 * num2
elif operator == "/":
    if num2 != 0:
        result = num1 / num2
    else:
        result = "Error: Cannot divide by zero!"
else:
    result = "Invalid operator!"

print("=============================")
print("Result:", result)
print("=============================")
